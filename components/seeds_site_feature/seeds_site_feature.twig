{#
/**
 * @file
 * Feature: icon, heading, text and an optional link.
 */
#}
{% set attributes = attributes.addClass('seeds-site-feature', 'seeds-site-feature--' ~ (style ?: 'card')) %}
<article{{ attributes }}>
  {% if icon and icon != 'none' %}
    <span class="seeds-site-feature__icon">
      {% include '@seeds_site_theme/includes/icon.html.twig' with { name: icon } only %}
    </span>
  {% endif %}
  <h3 class="seeds-site-feature__heading">{{ heading }}</h3>
  {% if text %}
    <p class="seeds-site-feature__text">{{ text }}</p>
  {% endif %}
  {% if link_text and link_url %}
    <a class="button button--ghost seeds-site-feature__link" href="{{ link_url }}">{{ link_text }}</a>
  {% endif %}
</article>
