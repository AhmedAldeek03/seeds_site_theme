{#
/**
 * @file
 * Seeds site theme: menus (main menu, footer menu and others).
 *
 * Seeds UI turns every parent item into a toggle with no link. Here a parent
 * with its own page (for example Media center) stays a link, and a separate
 * chevron button opens its submenu (the "disclosure" navigation pattern):
 * - Large screens: the submenu also opens on hover.
 * - Mobile drawer: the button opens the submenu in place.
 * Parents set to <nolink> or <button> are the toggle themselves.
 *
 * In the main menu, a top-level submenu is a mega panel: full width under the
 * header on large screens, with the parent's title, a "View all" link when
 * the parent has its own page, and each link's description (the menu link's
 * Description field) under its title. In the mobile drawer it stays a list.
 *
 * Available variables: menu_name, items, attributes (see core's menu.html.twig).
 */
#}
{% import _self as menus %}
{#
  Footer menu with nested links: each parent becomes a column with its title
  as the heading (for example Solutions, Industries, Company). Top-level
  links without children share one last column.
#}
{% set parents = menu_name == 'footer' ? items|filter(i => i.below is not empty) : [] %}
{% if parents is not empty %}
  {% set loose = items|filter(i => i.below is empty) %}
  <div class="menu-columns">
    {% for item in parents %}
      <div class="menu-columns__column">
        <h2 class="menu-columns__heading">{{ item.title }}</h2>
        {{ menus.menu_links(item.below, create_attribute({ 'class': ['menu', 'menu--footer'] }), 1, menu_name) }}
      </div>
    {% endfor %}
    {% if loose is not empty %}
      <div class="menu-columns__column">
        {{ menus.menu_links(loose, create_attribute({ 'class': ['menu', 'menu--footer'] }), 0, menu_name) }}
      </div>
    {% endif %}
  </div>
{% else %}
  {{ menus.menu_links(items, attributes.addClass('menu', 'menu--' ~ menu_name|clean_class), 0, menu_name) }}
{% endif %}

{% macro menu_links(items, attributes, menu_level, menu_name) %}
  {% import _self as menus %}
  {% if items %}
    <ul{{ attributes.addClass('menu--level-' ~ (menu_level + 1)) }}>
      {% for item in items %}
        {% if item.url.isRouted and item.url.routeName == '<nolink>' %}
          {% set type = 'nolink' %}
        {% elseif item.url.isRouted and item.url.routeName == '<button>' %}
          {% set type = 'button' %}
        {% else %}
          {% set type = 'link' %}
        {% endif %}
        {% set has_children = item.below is not empty %}
        {% set submenu_id = (menu_name ~ '-' ~ item.title ~ '-submenu-' ~ menu_level ~ '-' ~ loop.index)|clean_id %}
        {%
          set item_classes = [
            'menu__item',
            'menu__item--' ~ type,
            'menu__item--level-' ~ (menu_level + 1),
            item.in_active_trail ? 'menu__item--active-trail',
            has_children ? 'menu__item--has-children',
          ]
        %}
        {%
          set link_classes = [
            'menu__link',
            'menu__link--' ~ type,
            'menu__link--level-' ~ (menu_level + 1),
            item.in_active_trail ? 'menu__link--active-trail',
            has_children ? 'menu__link--has-children',
          ]
        %}
        <li{{ item.attributes.addClass(item_classes) }}{% if has_children %} x-data="{ open: false }" :class="{ 'is-open': open }" @mouseenter="if (matchMedia('(min-width: 992px) and (hover: hover)').matches) open = true" @mouseleave="if (matchMedia('(min-width: 992px) and (hover: hover)').matches) open = false" @focusout="if (!$el.contains($event.relatedTarget)) open = false" @click.outside="open = false" @keydown.escape.stop="open = false; $refs.toggle.focus()"{% endif %}>
          {% if has_children and type != 'link' %}
            <button type="button" x-ref="toggle" class="{{ link_classes|join(' ') }} menu__toggle menu__toggle--label" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-controls="{{ submenu_id }}">
              <span>{{ item.title }}</span>
              {% include '@seeds_site_theme/includes/icon.html.twig' with { name: 'chevron', class: 'menu__chevron' } only %}
            </button>
          {% else %}
            {{ link(item.title, item.url, { 'class': link_classes }) }}
            {% if has_children %}
              <button type="button" x-ref="toggle" class="menu__toggle" @click="open = !open" :aria-expanded="open.toString()" aria-expanded="false" aria-controls="{{ submenu_id }}">
                {% include '@seeds_site_theme/includes/icon.html.twig' with { name: 'chevron', class: 'menu__chevron' } only %}
                <span class="visually-hidden">{{ 'Show @title submenu'|t({ '@title': item.title }) }}</span>
              </button>
            {% endif %}
          {% endif %}
          {% if has_children and menu_name == 'main' and menu_level == 0 %}
            <div id="{{ submenu_id }}" class="menu__submenu menu__mega" x-show="open" x-transition.opacity.duration.150ms x-cloak>
              <div class="container menu__mega-inner{{ item.promo ? ' menu__mega-inner--promo' }}">
                <div class="menu__mega-main">
                <div class="menu__mega-head">
                  <p class="menu__mega-title">{{ item.title }}</p>
                  {% if type == 'link' %}
                    <a class="menu__mega-all" href="{{ item.url }}">{{ 'View all'|t }}</a>
                  {% endif %}
                </div>
                <ul class="menu menu--submenu menu--level-2 menu__mega-list">
                  {% for child in item.below %}
                    {% set description = child.original_link.getDescription() %}
                    <li{{ child.attributes.addClass('menu__item', 'menu__item--level-2', child.in_active_trail ? 'menu__item--active-trail') }}>
                      <a class="menu__link menu__link--level-2 menu__mega-link{{ child.in_active_trail ? ' menu__link--active-trail' }}" href="{{ child.url }}">
                        <span class="menu__mega-link-title">{{ child.title }}</span>
                        {% if description and description != child.title %}
                          <span class="menu__mega-link-text">{{ description }}</span>
                        {% endif %}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
                </div>
                {% if item.promo %}
                  <a class="menu__promo" href="{{ item.promo.url }}">
                    {% if item.promo.image %}
                      <span class="menu__promo-media">{{ item.promo.image }}</span>
                    {% endif %}
                    <span class="menu__promo-body">
                      {% if item.promo.label %}
                        <span class="menu__promo-label">{{ item.promo.label }}</span>
                      {% endif %}
                      <span class="menu__promo-title">{{ item.promo.title }}</span>
                      <span class="menu__promo-more">{{ 'Read more'|t }}</span>
                    </span>
                  </a>
                {% endif %}
              </div>
            </div>
          {% elseif has_children %}
            <div id="{{ submenu_id }}" class="menu__submenu dropdown-menu" x-show="open" x-transition.opacity.duration.150ms x-cloak>
              {{ menus.menu_links(item.below, create_attribute({ 'class': ['menu', 'menu--submenu'] }), menu_level + 1, menu_name) }}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
